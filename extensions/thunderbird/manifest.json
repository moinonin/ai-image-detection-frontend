{
  "manifest_version": 2,
  "name": "VeriForensic Email Verifier",
  "version": "0.2.0",
  "description": "Verify selected email provenance through VeriForensic.",
  "applications": {
    "gecko": {
      "id": "veriforensic@example.com",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "messagesRead",
    "activeTab",
    "storage",
    "notifications",
    "menus",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "scripts": ["background.js"] },
  "browser_action": {
    "default_title": "Verify email provenance",
    "default_popup": "popup.html"
  },
  "commands": {
    "verify-provenance": {
      "suggested_key": { "default": "Ctrl+Shift+V" },
      "description": "Verify provenance for the selected message"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
